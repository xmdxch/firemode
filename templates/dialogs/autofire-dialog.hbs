<form class="htbah-autofire-dialog" data-action="fire">
  <div class="form-group">
    <label for="autofire-bullets">{{localize "HTBAH.AutofireDialog.Bullets"}}</label>
    <input type="number" id="autofire-bullets" name="bullets" value="{{bullets}}" min="1" max="{{maxBullets}}" />
    <small class="hint">{{localize "HTBAH.AutofireDialog.Hint"}}</small>
  </div>
  <footer class="dialog-buttons">
    <button type="submit" class="dialog-button fire default" data-action="fire">
      <i class="fas fa-burst"></i>
      {{localize "HTBAH.AutofireDialog.Fire"}}
    </button>
    <button type="button" class="dialog-button cancel" data-action="cancel">
      <i class="fas fa-times"></i>
      {{localize "Cancel"}}
    </button>
  </footer>
</form>
